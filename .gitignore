# .gitignore

## Dependencies

node_modules/

## SvelteKit build output

.svelte-kit/
build/
dist/

## Vite

vite.config.ts.timestamp-*

## Environment variables

.env
.env.*
!.env.example

## Logs

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

## OS files

.DS_Store
Thumbs.db

## Editor

.vscode/
.idea/

## TypeScript

*.tsbuildinfo

## Coverage (if tests are added later)

coverage/

## Local IndexedDB / cache files (if ever exported accidentally)

*.db
*.sqlite
*.sqlite3

## Optional: keep package lock (DO NOT ignore these)

# package-lock.json

# pnpm-lock.yaml

# yarn.lock
